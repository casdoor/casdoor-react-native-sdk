{
  "name": "casdoor-react-native-sdk",
  "version": "1.0.0",
  "description": "React-Native client SDK for Casdoor",
  "main": "lib/cjs/index.js",
  "typings": "lib/cjs/index.d.ts",
  "module": "lib/esm/index.js",
  "license": "Apache-2.0",
  "scripts": {
    "prepack": "run-s build",
    "postpack": "run-s clean",
    "build": "run-s clean && run-p build:*",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "clean": "rimraf lib",
    "test": "jest",
    "coverage": "jest --coverage",
    "semantic-release": "semantic-release"
  },
  "jest": {
    "maxConcurrency": 1,
    "maxWorkers": 1,
    "testTimeout": 30000,
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.(t|j)sx?$": "ts-jest"
    },
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.(jsx?|tsx?)$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "^1.19.3",
    "@types/jest": "^27.0.2",
    "jest": "^27.2.1",
    "npm-run-all": "^4.1.5",
    "rimraf": "^3.0.2",
    "semantic-release": "^25.0.9",
    "ts-jest": "^27.0.5",
    "typescript": "^4.5.5"
  },
  "files": [
    "lib"
  ],
  "keywords": [
    "auth",
    "authn",
    "authentication",
    "sso",
    "oauth",
    "oidc",
    "casbin",
    "casdoor"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/casdoor/casdoor-react-native-sdk.git"
  },
  "author": {
    "name": "Wenpeng Chen",
    "email": "wenpengchen@njust.edu.cn"
  },
  "bugs": {
    "url": "https://github.com/casdoor/casdoor-react-native-sdk/issues"
  },
  "homepage": "https://github.com/casdoor/casdoor-react-native-sdk",
  "dependencies": {
    "jwt-decode": "^3.1.2",
    "pkce-challenge": "3.1.0"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "^1.19.3 || ^2.0.0"
  }
}
